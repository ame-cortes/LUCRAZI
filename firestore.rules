rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.allowAdmin == true;
    }

    match /articles/{articleId} {
      allow read: if isAdmin()
        || resource.data.status == "published";
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["slug", "status", "article", "updatedAt"])
        && request.resource.data.slug == articleId
        && request.resource.data.status in ["draft", "published"]
        && request.resource.data.article is map
        && request.resource.data.article.slug == articleId;
      allow delete: if isAdmin();
    }

    match /deletedArticles/{articleId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["slug", "updatedAt"])
        && request.resource.data.slug == articleId;
      allow delete: if isAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if settingId == "homepage";
      allow create, update: if isAdmin()
        && settingId == "homepage"
        && request.resource.data.keys().hasOnly(["featuredSlugs"])
        && request.resource.data.featuredSlugs is list
        && request.resource.data.featuredSlugs.size() <= 6
        && (request.resource.data.featuredSlugs.size() < 1
          || (request.resource.data.featuredSlugs[0] is string
            && request.resource.data.featuredSlugs[0].matches("^[a-z0-9]+(-[a-z0-9]+)*$")))
        && (request.resource.data.featuredSlugs.size() < 2
          || (request.resource.data.featuredSlugs[1] is string
            && request.resource.data.featuredSlugs[1].matches("^[a-z0-9]+(-[a-z0-9]+)*$")))
        && (request.resource.data.featuredSlugs.size() < 3
          || (request.resource.data.featuredSlugs[2] is string
            && request.resource.data.featuredSlugs[2].matches("^[a-z0-9]+(-[a-z0-9]+)*$")))
        && (request.resource.data.featuredSlugs.size() < 4
          || (request.resource.data.featuredSlugs[3] is string
            && request.resource.data.featuredSlugs[3].matches("^[a-z0-9]+(-[a-z0-9]+)*$")))
        && (request.resource.data.featuredSlugs.size() < 5
          || (request.resource.data.featuredSlugs[4] is string
            && request.resource.data.featuredSlugs[4].matches("^[a-z0-9]+(-[a-z0-9]+)*$")))
        && (request.resource.data.featuredSlugs.size() < 6
          || (request.resource.data.featuredSlugs[5] is string
            && request.resource.data.featuredSlugs[5].matches("^[a-z0-9]+(-[a-z0-9]+)*$")));
      allow delete: if isAdmin() && settingId == "homepage";
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }
  }
}
